# Bicameral Bot — example environment configuration
#
# Copy to `.env` and fill in real values locally. `.env` is gitignored
# (Confidential per the Data Management Policy — never commit real values).
# This file documents variable NAMES only; it carries no secrets.

# Google Drive OAuth application bootstrap (bot#1114 / cloud#262)
# Production behavior is Cloud-first: the daemon obtains bounded non-secret
# native-client metadata from the Bicameral Cloud app-config endpoint.
# The environment is the deployment target (production/staging), not the alpha
# product/admission phase.
# BICAMERAL_CLOUD_ORIGIN=https://app.bicameral-ai.com
# BICAMERAL_GOOGLE_OAUTH_EXPECTED_ENVIRONMENT=production

# Explicit development/recovery override only. Without this flag, legacy local
# client configuration never outranks Cloud rotation/disablement.
# BICAMERAL_GOOGLE_OAUTH_ALLOW_ENV_OVERRIDE=1
# BICAMERAL_GOOGLE_CLIENT_ID=
# BICAMERAL_GOOGLE_CLIENT_SECRET=      # Confidential legacy override only; never commit a real value
# BICAMERAL_GOOGLE_REDIRECT_URI=
# BICAMERAL_GOOGLE_SCOPES=

# GitHub device-flow client (crates/bicameral-gateway/src/github_device_flow.rs)
BICAMERAL_GITHUB_CLIENT_ID=

# Dashboard static-asset directory (optional; defaults to the bundled assets)
