{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bicameral.dev/protocol/spec-registry/v1/reject-snapshot.schema.json",
  "title": "RejectSnapshot",
  "description": "The owner rejects one tracked snapshot that is not in a conflict set. Records the owner and the daemon that cranked the write. Policy does not reject. Factory #946. ADR-0034.",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_uri", "snapshot_addr", "person_id", "daemon_id"],
  "properties": {
    "source_uri": {
      "type": "string",
      "minLength": 1,
      "description": "Same string as Source.uri."
    },
    "snapshot_addr": {
      "type": "string",
      "minLength": 1,
      "description": "Tracked snapshot being rejected."
    },
    "person_id": {
      "type": "string",
      "minLength": 1,
      "description": "The owner who rejected the snapshot."
    },
    "daemon_id": {
      "type": "string",
      "minLength": 1,
      "description": "Daemon that cranked the write."
    }
  }
}
