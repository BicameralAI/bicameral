{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bicameral.dev/protocol/spec-registry/v1/prompt-assignment.schema.json",
  "title": "PromptAssignment",
  "description": "The one current prompt for a hosted route. The daemon sends route and receives this. Not an entity on factory #935. ADR-0033.",
  "type": "object",
  "additionalProperties": false,
  "required": ["route", "prompt_id"],
  "properties": {
    "route": { "type": "string", "enum": ["system_one", "openai_compatible"] },
    "prompt_id": { "type": "string", "minLength": 1 }
  }
}
