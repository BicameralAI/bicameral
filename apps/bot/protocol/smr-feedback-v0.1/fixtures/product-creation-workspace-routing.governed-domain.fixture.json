    "normalized_claim_set": {
    "claims": [
      {"claim_id":"claim.alpha.c01.creation-prerequisites","revision":0,"context_statement":"Canonical creation requires explicit supported provider/resource selection, operator-level connection, descriptor validation, and adapter resolution.","source_anchor_ids":["anchor.alpha.product-creation"],"assertion_ids":["assert.alpha.c01.creation-prerequisites"]},
      {"claim_id":"claim.alpha.c02.connection-resumes-draft","revision":0,"context_statement":"Missing provider access uses the shared Connection service and resumes the same retained draft; failure leaves a retryable draft and creates no Product.","source_anchor_ids":["anchor.alpha.product-creation"],"assertion_ids":["assert.alpha.c02.connection-resumes-draft"]},
      {"claim_id":"claim.alpha.c03.adapter-owns-events","revision":0,"context_statement":"The selected event-store adapter owns canonical Product events. Cloud publication is a separate non-canonical projection.","source_anchor_ids":["anchor.alpha.product-creation"],"assertion_ids":["assert.alpha.c03.adapter-owns-events"]},
      {"claim_id":"claim.alpha.c04.proof-before-publication","revision":0,"context_statement":"Cloud publication is forbidden until the provider confirms the exact first event through a bounded commit proof; the proof is a witness, not lifecycle state.","source_anchor_ids":["anchor.alpha.product-creation"],"assertion_ids":["assert.alpha.c04.proof-before-publication"]},
      {"claim_id":"claim.alpha.c05.independent-commit-points","revision":0,"context_statement":"Connection, canonical creation, provider confirmation, Cloud publication, local registration, and replay are independent observable commit points.","source_anchor_ids":["anchor.alpha.product-creation"],"assertion_ids":["assert.alpha.c05.independent-commit-points"]},
      {"claim_id":"claim.alpha.c06.setup-repair-reconnect-states","revision":0,"context_statement":"Pre-registration incompleteness is `needs_setup`; post-registration access/replay failure is `repair_required`; daemon loss routes to pairing/reconnect, not an `offline` Product row.","source_anchor_ids":["anchor.alpha.product-creation"],"assertion_ids":["assert.alpha.c06.setup-repair-reconnect-states"]},
      {"claim_id":"claim.alpha.c07.idempotent-recovery","revision":0,"context_statement":"Partial-failure recovery is idempotent and cannot duplicate Product, first event, proof, registration, or Cloud row.","source_anchor_ids":["anchor.alpha.product-creation"],"assertion_ids":["assert.alpha.c07.idempotent-recovery"]},
      {"claim_id":"claim.alpha.c08.explicit-registration","revision":0,"context_statement":"A runnable Product requires explicit hosted-assisted or local-only registration; cwd/upward `.bicameral/` discovery is forbidden.","source_anchor_ids":["anchor.alpha.workspace-routing"],"assertion_ids":["assert.alpha.c08.explicit-registration"]},
      {"claim_id":"claim.alpha.c09.binding-boundary","revision":0,"context_statement":"`LocalWorkspaceBinding` is Product-keyed local code access, not Product identity, source binding, BindingEvidence, canonical state, or approval.","source_anchor_ids":["anchor.alpha.workspace-routing"],"assertion_ids":["assert.alpha.c09.binding-boundary"]},
      {"claim_id":"claim.alpha.c10.binding-only-repair","revision":0,"context_statement":"A missing or invalid local path makes only the binding `repair_required`; Product registration remains valid.","source_anchor_ids":["anchor.alpha.workspace-routing"],"assertion_ids":["assert.alpha.c10.binding-only-repair"]},
      {"claim_id":"claim.alpha.c11.sessionstart-routing","revision":0,"context_statement":"On genuine SessionStart, the host workspace path is only a routing hint. The daemon may return `product_id` only from exactly one valid existing binding. An `unbound`, `repair_required`, `ambiguous`, or `product_context_required` outcome fails closed with a typed no-run result; the host never infers or chooses a Product.","source_anchor_ids":["anchor.alpha.workspace-routing"],"assertion_ids":["assert.alpha.c11.sessionstart-routing"]},
      {"claim_id":"claim.alpha.c12.activation-readiness-separation","revision":0,"context_statement":"SessionStart activation and Product/workspace readiness remain separate. Lookup and hook receipts create or approve no Product, binding, Decision, or release state.","source_anchor_ids":["anchor.alpha.workspace-routing"],"assertion_ids":["assert.alpha.c12.activation-readiness-separation"]}
    ],
