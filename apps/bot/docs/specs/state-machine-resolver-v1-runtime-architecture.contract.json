{
  "contract_id": "state-machine-resolver-v1-runtime-architecture",
  "contract_version": 1,
  "digest_profile_version": 1,
  "issue": 937,
  "contract_pr": 942,
  "owner_bundle_comment_id": 5095866461,
  "disposition": "AMEND",
  "authorizes_implementation": false,
  "authorizes_release": false,
  "specification": "docs/specs/state-machine-resolver-v1-runtime-architecture.md",
  "schema_root": "protocol/smr-claim-acceptance/schemas",
  "fixture_root": "protocol/smr-claim-acceptance/fixtures",

  "elements": [
    {
      "id": "daemon",
      "kind": "authority",
      "canonical_writer": true,
      "may": [
        "validate proposals",
        "mint confirmation challenges",
        "append canonical events",
        "reconcile local projections",
        "derive event_stream_id from product_id"
      ],
      "must_not": [
        "accept extractor-supplied authority",
        "append on failed validation",
        "silently rehash or rewrite a proposal",
        "substitute a newer candidate generation"
      ]
    },
    {
      "id": "mcp",
      "kind": "surface",
      "canonical_writer": false,
      "may": ["display daemon-authored exact effect", "relay one explicit human gesture"],
      "must_not": ["mint", "normalize", "rank", "approve", "persist canonical Claims"]
    },
    {
      "id": "integrations",
      "kind": "transport",
      "canonical_writer": false,
      "may": ["transport screened evidence", "transport advisory hints"],
      "must_not": ["define Claims", "define contradictions", "define acceptance", "define canonical identity"]
    },
    {
      "id": "claim_extraction_provider",
      "kind": "advisory",
      "canonical_writer": false,
      "may": ["emit advisory noncanonical candidate content"],
      "must_not": ["supply authority fields", "supply approval", "supply canonical identity"],
      "notes": "Provider identity is provenance, never Claim identity. Alpha defaults to caller and local. No silent hosted fallback."
    },
    {
      "id": "daemon_local_sqlite",
      "kind": "working_state",
      "canonical": false,
      "rebuildable": true,
      "may": ["hold durable working state", "hold rebuildable projections"],
      "must_not": ["serve as canonical truth"]
    },
    {
      "id": "canonical_event_log",
      "kind": "canonical_state",
      "canonical": true,
      "sole_commit_point": true,
      "must_not": ["be rewritten", "be deleted", "be reordered"]
    }
  ],

  "relationships": [
    {
      "from": "mcp",
      "to": "daemon",
      "kind": "relays_human_gesture",
      "confers_authority": false
    },
    {
      "from": "daemon",
      "to": "canonical_event_log",
      "kind": "sole_appender",
      "confers_authority": true
    },
    {
      "from": "canonical_event_log",
      "to": "daemon_local_sqlite",
      "kind": "reconciles_after_append",
      "direction": "canonical_to_working",
      "repairable": true
    },
    {
      "from": "claim_extraction_provider",
      "to": "daemon",
      "kind": "advisory_input",
      "confers_authority": false
    },
    {
      "from": "claim_set_candidate_promoted",
      "to": "decision",
      "kind": "atomically_creates",
      "cardinality": "1:1",
      "resulting_signoff_state": "approved"
    }
  ],

  "state_records": {
    "candidate_lifecycle": {
      "durable_states": ["proposed", "promoted", "rejected"],
      "initial": "proposed",
      "terminal": ["promoted", "rejected"]
    },
    "decision_signoff_lifecycle": {
      "durable_states": ["proposed", "approved", "rejected", "superseded"],
      "initial": "approved",
      "terminal": ["approved", "rejected", "superseded"],
      "authority": "product_owner",
      "alpha_every_current_participant_is_product_owner": true,
      "claim_effect_by_state": {
        "proposed": "out_of_alpha_claim_set_path",
        "approved": "canonical_recallable_authoritative",
        "rejected": "immutable_history_only",
        "superseded": "immutable_history_only"
      }
    },
    "orthogonal_attributes": {
      "currentness": {
        "values": ["current", "stale"],
        "reason_enum": [
          "artifact_drift",
          "base_snapshot_drift",
          "scope_drift",
          "schema_drift",
          "evidence_drift"
        ],
        "closed": true,
        "derived_by": "daemon"
      },
      "promotion_eligibility": {
        "values": ["eligible", "invalid"],
        "reason_enum": [
          "proposal_identity_mismatch",
          "schema_unsupported",
          "scope_insufficient",
          "evidence_missing",
          "authority_absent",
          "proposal_too_large",
          "routing_mismatch"
        ],
        "closed": true,
        "derived_by": "daemon"
      },
      "analysis_status": {
        "values": ["complete", "needs_reanalysis", "deferred", "failed"],
        "reason_enum": [
          "extraction_error",
          "provider_unavailable",
          "context_budget_exceeded",
          "artifact_unreadable"
        ],
        "closed": true,
        "derived_by": "daemon"
      },
      "visibility": {
        "values": ["visible", "suppressed"],
        "reason_enum": ["duplicate_fingerprint", "prior_rejection", "policy"],
        "closed": true,
        "derived_by": "daemon"
      }
    },
    "claim_influence": {
      "values": ["recommendation", "authoritative"],
      "claim_set_promote_writes": "authoritative",
      "pinned_to_recommendation_while": "out_of_alpha_for_claim_set_path",
      "excluded_from_effective_projection_when": [
        "resulting_decision.signoff_state == rejected",
        "resulting_decision.signoff_state == superseded"
      ]
    },
    "not_lifecycle_states": ["stale", "invalidated", "suppressed", "needs_reanalysis"]
  },

  "transitions": [
    {
      "id": "TR-PROPOSE",
      "from": null,
      "to": "proposed",
      "writer": "daemon_extraction_coordinator",
      "command": "smr.claims.propose",
      "canonical_append": null,
      "creates_generation": true
    },
    {
      "id": "TR-PROMOTE",
      "from": "proposed",
      "to": "promoted",
      "writer": "daemon",
      "authorized_by": "existing MCP-to-daemon review path",
      "command": "recall.promote_decision_candidate",
      "canonical_append": "claim_set_candidate_promoted",
      "claim_bearing": true,
      "required_role_at_append": "product_owner",
      "atomic_preconditions": [
        "candidate generation has no terminal disposition",
        "actor currently has Product Owner authority",
        "proposal base matches current canonical Claim projection"
      ],
      "requires_confirmation_protocol_version": 2,
      "advances": ["canonical_event_log_digest", "claim_projection_digest"]
    },
    {
      "id": "TR-REJECT",
      "from": "proposed",
      "to": "rejected",
      "writer": "daemon",
      "authorized_by": "existing review rejection surface",
      "canonical_append": "claim_set_candidate_rejected",
      "claim_bearing": false,
      "required_role_at_append": "product_owner",
      "atomic_preconditions": [
        "candidate generation has no terminal disposition",
        "actor currently has Product Owner authority"
      ],
      "advances": ["canonical_event_log_digest"],
      "unchanged": ["claim_projection_digest"]
    },
    {
      "id": "TR-REANALYZE",
      "from": "proposed",
      "to": "proposed",
      "writer": "daemon_extraction_coordinator",
      "creates_generation": true,
      "rewrites_inspected_generation": false,
      "canonical_append": null
    },
    {
      "id": "TR-SIGNOFF",
      "scope": "decision",
      "from": "proposed",
      "to": "approved",
      "distinct_from": "TR-PROMOTE",
      "required_role_at_append": "product_owner",
      "authorization_checked_at": "canonical_append",
      "raises_influence_to": "authoritative",
      "canonical_append": "approve_signoff",
      "notes": "Deferred out of alpha for claim-set acceptance; promotion already writes approved."
    },

    {
      "id": "TR-REJECT-SIGNOFF",
      "scope": "decision",
      "from": "proposed",
      "to": "rejected",
      "required_role_at_append": "product_owner",
      "authorization_checked_at": "canonical_append",
      "claim_effect": "immutable_history_only",
      "canonical_append": "reject_signoff",
      "notes": "Uses the pre-existing owner-only signoff rejection transition."
    },

    {
      "id": "TR-SUPERSEDE",
      "scope": "decision",
      "from": ["proposed", "approved"],
      "to": "superseded",
      "required_role_at_append": "product_owner",
      "authorization_checked_at": "canonical_append",
      "claim_effect": "immutable_history_only",
      "canonical_append": "supersede_decision",
      "notes": "Uses the pre-existing owner-only supersession transition."
    }
  ],

  "temporal_invariants": {
    "candidate_terminal_disposition": {
      "key": ["product_id", "candidate_id", "candidate_generation"],
      "events": ["claim_set_candidate_promoted", "claim_set_candidate_rejected"],
      "cardinality": "at_most_one",
      "enforced_by": "canonical_stream_compare_and_append",
      "conflict_result": "candidate_already_disposed"
    },
    "append_time_authorization": {
      "promotion_role": "product_owner",
      "signoff_role": "product_owner",
      "alpha_every_current_participant_is_product_owner": true,
      "checked_at": "same canonical compare_and_append operation",
      "challenge_is_authority": false,
      "revoked_result": "Unauthorized"
    },
    "base_snapshot_freshness": {
      "precondition": "proposal base_event_position and smr_base_snapshot_digest equal the current canonical Claim projection",
      "checked_at": "same canonical compare_and_append operation",
      "mismatch_result": "base_snapshot_drift",
      "appends_on_mismatch": false
    },
    "projection_read_freshness": {
      "success_precondition": "daemon_local_sqlite.projection_cursor == canonical_event_log.head_position",
      "catch_up_before_read": true,
      "catch_up_failure_result": "model_unavailable",
      "stale_or_empty_fallback": false
    },
    "replay_totality": {
      "required_predecessors": {
        "approve_signoff": "deferred_out_of_alpha_claim_set_path",
        "reject_signoff": "Decision(approved)",
        "supersede_decision": "Decision(approved)"
      },
      "self_contained_terminal_events": [
        "claim_set_candidate_promoted",
        "claim_set_candidate_rejected"
      ],
      "forbidden_canonical_generation_event": "claim_set_candidate_generated",
      "candidate_generation_predecessor_required": false,
      "append_time_candidate_generation": {
        "required_for": "live_j2_compare_and_append",
        "not_required_for": "replay",
        "requires": [
          "daemon_local_candidate",
          "confirmation_challenge_v2",
          "current_member_authority",
          "fresh_base_snapshot"
        ]
      },
      "second_terminal_replay_result": "invalid_canonical_history",
      "missing_predecessor_result": "invalid_canonical_history",
      "silent_ignore": false
    },
    "model_atom_identity": {
      "identity_inputs": ["atom_kind", "normalized semantic_key", "normalized semantic scope"],
      "normalization": "digest profile v1",
      "same_semantics_same_identity": true,
      "extractor_supplied_identity_authoritative": false,
      "collision_or_alias_result": "proposal_identity_mismatch"
    }
  },

  "forbidden_transitions": [
    {
      "id": "FT-REVERSE-COMMIT",
      "description": "mark SQLite promoted then attempt canonical append",
      "result": "non-conformant"
    },
    {
      "id": "FT-PARALLEL-APPROVAL",
      "description": "introduce smr.approve or smr.accept_claim_set command family",
      "result": "non-conformant",
      "notes": "Standing prohibition. No such command has ever existed in this repository."
    },
    {
      "id": "FT-CLAIM-BEARING-REJECTION",
      "description": "append an accepted claim-bearing event on rejection",
      "result": "non-conformant"
    },
    {
      "id": "FT-REPLAY-PROVIDER-CALL",
      "description": "invoke a provider or extractor during replay",
      "result": "non-conformant"
    },
    {
      "id": "FT-DOUBLE-DISPOSITION",
      "description": "append both promotion and rejection, or two promotions, for one candidate generation",
      "result": "non-conformant"
    },
    {
      "id": "FT-STALE-AUTHORITY",
      "description": "treat challenge issuance as authority without rechecking current Product role at canonical append",
      "result": "non-conformant"
    },
    {
      "id": "FT-STALE-BASE-APPEND",
      "description": "append promotion after the relevant canonical Claim projection has drifted from the bound base",
      "result": "non-conformant"
    },
    {
      "id": "FT-STALE-PROJECTION-READ",
      "description": "return a successful SMR read while the SQLite projection cursor trails canonical event head",
      "result": "non-conformant"
    },
    {
      "id": "FT-ORPHAN-REPLAY",
      "description": "silently ignore a signoff or supersession event whose required Decision predecessor is absent",
      "result": "non-conformant"
    },
    {
      "id": "FT-GENERATED-CANDIDATE-PREDECESSOR",
      "description": "require a canonical Candidate-generation predecessor on replay, or append claim_set_candidate_generated, so unreviewed extract becomes Product history",
      "result": "non-conformant"
    }
  ],

  "canonical_events": [
    {
      "event_type": "claim_set_candidate_promoted",
      "event_schema_version": 1,
      "claim_bearing": true,
      "additive": true,
      "overloads_accept_candidate": false,
      "schema": "claim-set-candidate-promoted.schema.json"
    },
    {
      "event_type": "claim_set_candidate_rejected",
      "event_schema_version": 1,
      "claim_bearing": false,
      "additive": true,
      "schema": "claim-set-candidate-rejected.schema.json"
    }
  ],

  "relation_support_provenance": {
    "required_fields": [
      "supporting_claim_ids",
      "supporting_source_anchor_ids"
    ],
    "minimum_items_each": 1,
    "normalization": "deduplicated and sorted by stable semantic ID",
    "same_claim_set_referential_integrity": true,
    "source_anchor_must_be_reachable_through_supporting_claim": true,
    "mismatch_result": "proposal_identity_mismatch",
    "appends_on_mismatch": false,
    "records": "proposal_input_lineage",
    "does_not_prove": [
      "semantic_entailment",
      "explicitness",
      "correctness",
      "authority"
    ],
    "prohibited_v1_fields": [
      "source_explicit",
      "rule_derived",
      "model_inferred"
    ],
    "deferred_receipt_fields": [
      "rule_id",
      "rule_version",
      "input_digest"
    ],
    "authority_boundary": "human acceptance of the exact claim_set_digest"
  },

  "digest_profile": {
    "version": 1,
    "hash": "SHA-256",
    "canonicalization": "RFC 8785 JCS",
    "construction": "\"sha256:\" || lowerhex(SHA-256(UTF8(\"bicameral/<artifact-name>/v1\") || 0x00 || JCS(normalized_value)))",
    "encoding": {
      "prefix": "sha256:",
      "body": "64 lowercase hexadecimal characters"
    },
    "normalization": [
      "NFC-normalize Unicode strings",
      "normalized POSIX repo-relative paths with no leading ./ or /",
      "deduplicate and sort set-like arrays by stable semantic ID before JCS",
      "explicit integer ordinals for ordered fragments; array position is never semantic",
      "omit absent optional fields; null forbidden unless explicitly schema-defined",
      "floating-point values forbidden in the normalized Claim schema",
      "exclude volatile timestamps, provider receipts, display summaries, and local database IDs"
    ],
    "identities": {
      "claim_set_digest": "claim-set",
      "artifact_binding_digest": "artifact-binding",
      "smr_base_snapshot_digest": "smr-base-snapshot",
      "claim_scope_digest": "claim-scope",
      "evidence_bundle_digest": "evidence-bundle",
      "display_summary_digest": "display-summary",
      "rejection_fingerprint": "rejection-fingerprint"
    },
    "prohibited_identity_names": ["canonical_snapshot_digest", "scope_digest"],
    "base_snapshot_position_field": "base_event_position",
    "bounds": {
      "claims": 512,
      "model_atoms": 4096,
      "claim_assertions": 8192,
      "atom_relations": 8192,
      "scopes": 256,
      "source_anchors": 8192,
      "serialized_event_bytes": 4194304,
      "exceeded_result": "proposal_too_large"
    }
  },

  "confirmation_protocol": {
    "version": 2,
    "ttl_seconds": 300,
    "storage": "daemon_memory_only",
    "single_use": true,
    "actor_bound": true,
    "invalid_after_daemon_restart": true,
    "binding_is_superset_of_v1": true,
    "retained_v1_bound_fields": [
      "protocol_version",
      "workspace",
      "actor_id",
      "session_id",
      "packet_id",
      "candidate_id",
      "requested_outcome",
      "request_id"
    ],
    "amended_by": "state-machine-resolver-v1-runtime-architecture-amendment-001",
    "added_v2_bound_fields": [
      "digest_profile_version",
      "challenge_id",
      "operation_id",
      "action",
      "product_id",
      "candidate_generation",
      "candidate_kind",
      "proposal_identity",
      "issued_at",
      "expires_at",
      "display_summary_digest"
    ],
    "excluded_from_binding_digest": ["display_summary"],
    "retained_v1_typed_outcomes": [
      "WorkspaceMismatch",
      "ActorMismatch",
      "PacketMismatch",
      "CandidateMismatch",
      "OutcomeMismatch",
      "Unauthorized"
    ],
    "confirmation_submits": [
      "protocol_version",
      "challenge_id",
      "operation_id",
      "confirmation_binding_digest",
      "gesture"
    ],
    "operation_identity": {
      "field": "operation_id",
      "supplied_by": "caller",
      "uniqueness_scope": ["product_id", "actor_id"],
      "distinct_from": "request_id",
      "aliasing_permitted": false
    },
    "schema": "confirmation-binding.v2.schema.json"
  },

  "version_compatibility": [
    {
      "presented": "confirmation_protocol_version=1",
      "target_kind": "smr_claim_set_v1",
      "result": "unsupported_contract_version"
    },
    {
      "presented": "confirmation_protocol_version=2",
      "target_kind": "decision_v1",
      "result": "unsupported_contract_version"
    },
    {
      "presented": "confirmation_protocol_version=1",
      "target_kind": "decision_v1",
      "result": "existing_behavior_unchanged"
    },
    {
      "presented": "unknown event_schema_version | proposal_schema_version | digest_profile_version",
      "target_kind": "any",
      "result": "unsupported_contract_version"
    }
  ],

  "migration": {
    "legacy_candidate_default_kind": "decision_v1",
    "absent_discriminator_reads_as": "decision_v1",
    "new_candidate_kind": "smr_claim_set_v1",
    "event_history_rewritten": false,
    "accept_candidate_interpretation_changed": false,
    "local_storage_added_fields": [
      "generation",
      "kind",
      "payload",
      "digests",
      "currentness",
      "promotion_eligibility",
      "analysis_status",
      "visibility"
    ],
    "unsupported_version_response": "unsupported_contract_version"
  },

  "scenarios": [
    {
      "id": "SC-HAPPY-PROMOTE",
      "given": "valid proposal, current candidate, authorized actor, unexpired v2 challenge",
      "when": "human confirms",
      "then": [
        "exactly one claim_set_candidate_promoted appended",
        "resulting Decision created with signoff_state=approved",
        "SQLite candidate reconciles to promoted",
        "SMR projection rebuilt from canonical history",
        "canonical receipt returned"
      ],
      "typed_result": "committed_once"
    },
    {
      "id": "SC-IDENTITY-MISMATCH",
      "given": "any bound digest or identity mutated after challenge issue",
      "when": "human confirms",
      "then": ["challenge invalidated", "nothing appended"],
      "typed_result": "proposal_identity_mismatch",
      "names_mismatched_field": true
    },
    {
      "id": "SC-LOST-RESPONSE-RESTART",
      "given": "canonical append succeeded, response lost, daemon restarted",
      "when": "same operation_id retried with the same confirmation binding",
      "then": ["prior canonical receipt returned", "no duplicate append", "no new challenge"],
      "typed_result": "replayed_result"
    },
    {
      "id": "SC-OPERATION-CONFLICT",
      "given": "operation_id already used",
      "when": "retried with a different confirmation binding",
      "then": ["nothing appended"],
      "typed_result": "operation_conflict",
      "permanent": true
    },
    {
      "id": "SC-CHALLENGE-EXPIRED",
      "given": "challenge older than 300 seconds",
      "when": "human confirms",
      "then": ["nothing appended"],
      "typed_result": "challenge_expired"
    },
    {
      "id": "SC-RESTART-BEFORE-APPEND",
      "given": "daemon restarted before canonical append",
      "when": "old challenge presented",
      "then": ["challenge fails", "fresh challenge permitted only after exact proposal revalidation"],
      "typed_result": "challenge_expired"
    },
    {
      "id": "SC-SQLITE-FAILS-AFTER-APPEND",
      "given": "canonical append succeeded",
      "when": "SQLite reconciliation fails",
      "then": ["acceptance stands", "typed reconciliation failure raised", "repair from canonical history"],
      "typed_result": "reconciliation_required"
    },
    {
      "id": "SC-REPLAY-DETERMINISM",
      "given": "local SQLite working state deleted and daemon restarted",
      "when": "canonical events replayed",
      "then": [
        "same accepted Claim identities reconstructed",
        "same SMR projection digest",
        "rejection tombstone index rebuilt",
        "provider_calls_during_replay == 0"
      ],
      "typed_result": "same_projection"
    },
    {
      "id": "SC-REJECT-DURABILITY",
      "given": "human rejects a candidate",
      "when": "claim_set_candidate_rejected appended and SQLite later deleted",
      "then": [
        "no accepted claim-bearing event appended",
        "claim_projection_digest unchanged",
        "canonical_event_log_digest advanced",
        "automatic extraction suppresses an exact rejection_fingerprint match"
      ],
      "typed_result": "committed_once"
    },
    {
      "id": "SC-REJECT-SEMANTIC-CHANGE",
      "given": "a prior rejection tombstone exists",
      "when": "semantically changed content produces a new fingerprint",
      "then": ["new candidate generation surfaces normally"],
      "typed_result": "compatible"
    },
    {
      "id": "SC-AUTHORITY-VIOLATION",
      "given": "MCP, extractor, Integrations, or caller attempts to mint or self-confirm approval",
      "when": "submitted",
      "then": ["nothing appended"],
      "typed_result": "daemon_only"
    },
    {
      "id": "SC-ROUTING-MISMATCH",
      "given": "caller supplies event_stream_id, or a derived stream does not belong to product_id",
      "when": "validated",
      "then": ["nothing appended"],
      "typed_result": "routing_mismatch"
    },
    {
      "id": "SC-PROPOSAL-TOO-LARGE",
      "given": "normalized claim set or serialized event exceeds a profile v1 bound",
      "when": "validated",
      "then": ["nothing appended"],
      "typed_result": "proposal_too_large"
    },
    {
      "id": "SC-LEGACY-COMPAT",
      "given": "an existing decision_v1 candidate",
      "when": "promoted through the unchanged path",
      "then": ["AcceptCandidate behavior unchanged", "RecallPacket renders both kinds unambiguously"],
      "typed_result": "compatible"
    },
    {
      "id": "SC-UNSUPPORTED-VERSION",
      "given": "an unrecognised contract version on any surface",
      "when": "received",
      "then": ["fail closed", "render nothing as accepted", "state not corrupted"],
      "typed_result": "unsupported_contract_version"
    },
    {
      "id": "SC-CONCURRENT-DISPOSITION",
      "given": "two different operation_ids target one proposed candidate generation",
      "when": "promote/promote or promote/reject race",
      "then": ["one terminal event commits", "the loser appends nothing"],
      "typed_result": "candidate_already_disposed"
