  "amendments": [
    { "id": "A1", "field": "confirmation_protocol.ttl_seconds", "bundle": 600, "replacement": 300, "reason": "shipped CONFIRMATION_CHALLENGE_TTL_SECONDS is 300; doubling the human-confirmation window widens stale and confused-deputy exposure" },
    { "id": "A2", "field": "confirmation_protocol.binding", "bundle": "drops workspace, session_id, packet_id", "replacement": "strict superset of v1", "reason": "those fields carry shipped typed fail-closed outcomes; routing identity and authorization scope are different concerns" },
    { "id": "A3", "field": "confirmation_binding_digest", "bundle": "includes display_summary text", "replacement": "includes display_summary_digest", "reason": "bundle both binds the summary and forbids display summaries in digests" },
    { "id": "A4", "field": "operation_id origin", "bundle": "unspecified", "replacement": "caller-supplied, unique per (product_id, actor_id)", "reason": "a daemon-minted identifier the caller never observed cannot be retried" },
    { "id": "A5", "field": "resulting_decision.decision_id", "bundle": "opaque uuid", "replacement": "deterministic UUIDv5", "reason": "a retry or concurrent submit under one operation_id must resolve to one Decision" },
    { "id": "A6", "field": "smr_base_snapshot_digest", "bundle": "self-referential at append", "replacement": "base_event_position required alongside", "reason": "the append changes the projection the digest describes" },
    { "id": "A7", "field": "routing.event_stream_id", "bundle": "selection unspecified", "replacement": "daemon-derived; caller-supplied rejected", "reason": "otherwise a caller selects its own canonical destination" },
    { "id": "A8", "field": "rejection digest invariant", "bundle": "prose only", "replacement": "canonical_event_log_digest advances; claim_projection_digest unchanged", "reason": "two named digests make the invariant testable" },
    { "id": "A9", "field": "lifecycle reason enums", "bundle": "such as / a closed reason", "replacement": "all four enums closed and enumerated", "reason": "illustrative reasons are not a durable contract" },
    { "id": "A10", "field": "digest encoding", "bundle": "unspecified", "replacement": "sha256: prefix, 64 lowercase hex", "reason": "two conformant implementations would otherwise disagree byte-for-byte" },
    { "id": "A11", "field": "normalized_claim_set size", "bundle": "unbounded", "replacement": "explicit bounds, typed proposal_too_large", "reason": "canonical events are immutable and permanent" },
    { "id": "A12", "field": "runtime spec document", "bundle": "correct existing document and remove smr.accept_claim_set", "replacement": "document created here; prohibition recorded as standing constraint", "reason": "neither the document nor the command existed in this repository or any sibling repository" },
    { "id": "A13", "field": "schema location", "bundle": "implied new contract root", "replacement": "protocol/smr-claim-acceptance/{schemas,fixtures}", "reason": "protocol/schemas/v1 and v2 are generated from Rust types by schema_gen and would drift" },
    { "id": "A14", "field": "preflight.lookup", "bundle": "named as shipped successor", "replacement": "recorded as forward-looking, not a shipped command", "reason": "the shipped read-only path is staged preflight with lookup.checkpoint_hint" },
    { "id": "A17", "field": "candidate terminal disposition", "bundle": "operation_id idempotency only", "replacement": "at most one terminal event per Product/candidate/generation under canonical compare-and-append", "reason": "different operation IDs could otherwise double-promote or promote and reject one generation" },
    { "id": "A18", "field": "transition authorization", "bundle": "challenge-time binding", "replacement": "current Product member/owner role rechecked atomically at append", "reason": "a revoked actor must not spend stale challenge authority" },
    { "id": "A19", "field": "SMR base freshness", "bundle": "base identity bound but not current", "replacement": "base position and digest compare against current canonical Claim projection at append", "reason": "concurrent Claim changes can invalidate the reviewed effect" },
    { "id": "A20", "field": "projection reads", "bundle": "reconciliation after append only", "replacement": "catch up SQLite to canonical head before successful SMR reads or return model_unavailable", "reason": "stale or empty fallback would misrepresent accepted Product history" },
    { "id": "A21", "field": "replay predecessors", "bundle": "unknown targets may be silently ignored", "replacement": "missing Candidate or Decision predecessor fails replay with invalid_canonical_history", "reason": "deterministic replay must be total over valid history" },
    { "id": "A22", "field": "ModelAtom identity", "bundle": "stable semantic ID prose", "replacement": "daemon verifies deterministic identity from normalized kind, semantic key, and scope", "reason": "semantic aliases could otherwise hide overlapping contradictions" },
    { "id": "A23", "field": "Decision governance envelope", "bundle": "approval transition only", "replacement": "member promotion creates proposed/recommendation; owner approval raises authority; rejection or supersession removes Claims from effective projection", "reason": "canonical Claim history and governance influence are distinct" },
    { "id": "A24", "field": "CodeGraph", "bundle": "implementation-evidence composition blocker", "replacement": "optional recall expansion only and never required for SMR closure", "reason": "alpha value is controlled spec recall and contradiction triage, not code compliance" },
    { "id": "A25", "field": "AtomRelation support provenance", "bundle": "no relation-to-source lineage; proposed categorical derivation labels", "replacement": "same-set supporting Claim and reachable SourceAnchor identities; no categorical derivation field in v1", "reason": "natural-language explicitness is not generally decidable, and extractor self-classification would recreate evidence laundering" },
    { "id": "A26", "field": "replay predecessors for claim-set terminals", "bundle": "promotion and rejection require a Candidate generation predecessor", "replacement": "promotion and rejection are self-contained; only Decision signoff/supersession requires a canonical Decision predecessor; live J2 append still checks the local candidate", "reason": "candidate generation is daemon-local working state; a generated-candidate event would put unreviewed extract into Product history before human confirm" },
    { "id": "A27", "field": "alpha claim-set authority", "bundle": "member promotion creates Decision(proposed) / recommendation; auto-join grants Member only", "replacement": "claim-set confirm writes Decision(approved) with authoritative influence; every current Product participant is Product Owner; Decision(proposed) is out of this alpha cut on this path; Policy Owner remains creator-only", "reason": "alpha scope cut: skip the recommendation window and the member/owner split on confirm" }
  ],

