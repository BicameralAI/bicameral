{
  "name": "bicameral-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node ../../../tools/npm-guard/gate.cjs --gate && vite",
    "build": "node ../../../tools/npm-guard/gate.cjs --gate && vite build",
    "preview": "node ../../../tools/npm-guard/gate.cjs --gate && vite preview",
    "check": "node ../../../tools/npm-guard/gate.cjs --gate && svelte-check --tsconfig ./tsconfig.json",
    "test": "node ../../../tools/npm-guard/gate.cjs --gate && vitest run",
    "evidence:ui": "node ../../../tools/npm-guard/gate.cjs --gate && playwright test",
    "smoke:live": "node ../../../tools/npm-guard/gate.cjs --gate && vite --host 127.0.0.1 --port 5173",
    "security:setup": "node ../../../tools/npm-guard/gate.cjs --setup",
    "security:check": "node ../../../tools/npm-guard/gate.cjs --check"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@playwright/test": "1.62.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@tsconfig/svelte": "^5.0.4",
    "jsdom": "^28.1.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tslib": "^2.6.0",
    "typescript": "^5.5.0",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  }
}
