{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bicameral.ai/schemas/release-rehearsal.schema.json",
  "title": "Bicameral non-publishing release rehearsal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rehearsal_id",
    "release_plan_id",
    "release_plan_digest",
    "version",
    "component_commits",
    "evaluated_under",
    "required_closures",
    "artifact_destination",
    "publication",
    "created_by",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "rehearsal_id": {"type": "string", "minLength": 1},
    "release_plan_id": {"type": "string", "minLength": 1},
    "release_plan_digest": {"$ref": "#/$defs/digest"},
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)([-+][0-9A-Za-z.-]+)?$"
    },
    "component_commits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bot", "cloud", "mcp", "integrations"],
      "properties": {
        "bot": {"$ref": "#/$defs/sha"},
        "cloud": {"$ref": "#/$defs/sha"},
        "mcp": {"$ref": "#/$defs/sha"},
        "integrations": {"$ref": "#/$defs/sha"}
      }
    },
    "evaluated_under": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factory_commit", "closure_policy_digest"],
      "properties": {
        "factory_commit": {"$ref": "#/$defs/sha"},
        "closure_policy_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "required_closures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "artifact_destination": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": {"const": "github_actions_artifact"},
            "name": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "prefix"],
          "properties": {
            "kind": {"const": "quarantined_object_prefix"},
            "prefix": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_tag",
        "github_release",
        "production_r2_latest",
        "cloud_deploy"
      ],
      "properties": {
        "git_tag": {"const": false},
        "github_release": {"const": false},
        "production_r2_latest": {"const": false},
        "cloud_deploy": {"const": false}
      }
    },
    "created_by": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
