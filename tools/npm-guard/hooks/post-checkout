#!/bin/sh
# After switching branches ($3 = 1): alarm if the new branch carries a malware signature.
[ "$3" = 1 ] || exit 0
# Runs from the copy that `npm run security:setup` installs in the git directory, never from the
# working tree, so a branch you check out or pull cannot change what runs here.
here=$(cd "$(dirname "$0")" && pwd)
sh "$here/py.sh" "$here/scan_incoming.py" --warn-only --range "$1" "$2"
exit 0
